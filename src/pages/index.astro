---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Terminal from '../components/Terminal.astro';
import ProjectList from '../components/ProjectList.astro';

const now = new Date();
const lastUpdated = `${now.getFullYear()}·${String(now.getMonth() + 1).padStart(2, '0')}`;
---

<BaseLayout title="Sam Warr">
  <main>
    <Header />
    <Terminal />
    <ProjectList />

    <footer>
      <span>built with Astro · Geist</span>
      <span>
        <a href="https://github.com/sammothxc/samwarr.dev">source ↗</a> ·
        last updated <span class="mono">{lastUpdated}</span>
      </span>
    </footer>
  </main>
</BaseLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  footer {
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--fg-subtle);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  footer a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  footer a:hover {
    color: var(--fg);
  }
</style>
