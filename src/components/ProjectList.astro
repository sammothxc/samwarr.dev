---
import { getCollection } from 'astro:content';
import { categories, categoryKeys } from '../data/categories';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    const key = (s: string) => {
      if (s === 'ongoing') return Infinity;
      const [mon, yr] = s.split(' ');
      const m = MONTHS.indexOf(mon);
      const y = parseInt(yr, 10);
      if (isNaN(y)) return 0;
      return y * 12 + (m >= 0 ? m : 0);
    };
    return key(b.data.year) - key(a.data.year);
  });

function hasWriteup(project: typeof allProjects[number]): boolean {
  return (project.body?.trim().length ?? 0) > 0;
}

const grouped = categoryKeys.map((key) => ({
  key,
  ...categories[key],
  projects: allProjects.filter((p) => p.data.category === key),
}));
---

<div id="projectList">
  {
    grouped.map((group) =>
      group.projects.length === 0 ? null : (
        <section class="group" data-category={group.key}>
          <button class="group-header" type="button" aria-expanded="true">
            <span class="chevron" aria-hidden="true">▸</span>
            <h2>{group.label}</h2>
            <span class="group-id">{group.id}</span>
          </button>
          {group.projects.map((p) => {
            const writeup = hasWriteup(p);
            const links: { label: string; href: string }[] = [];
            if (writeup) links.push({ label: 'details', href: `/projects/${p.id}` });
            if (p.data.live) links.push({ label: 'live', href: p.data.live });
            if (p.data.repo) links.push({ label: 'repo', href: p.data.repo });

            return (
              <article
                class="project"
                data-id={p.id}
                data-category={p.data.category}
                data-tags={p.data.tags.join(',')}
                data-year={p.data.year}
                data-writeup={writeup ? 'true' : 'false'}
              >
                <span class="year mono">{p.data.year}</span>
                <div class="body">
                  <h3>
                    <span>{p.data.title}</span>
                  </h3>
                  <p>{p.data.description}</p>
                  <div class="tags">
                    {p.data.tags.map((t, i) => (
                      <>
                        {i > 0 && ' · '}
                        <span class="tag">{t}</span>
                      </>
                    ))}
                  </div>
                </div>
                {links.length > 0 && (
                  <div class="links">
                    {links.map((l) => (
                      <a href={l.href}>{l.label} →</a>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </section>
      )
    )
  }
</div>

<style>
  .group {
    margin-bottom: 56px;
    transition: opacity 0.2s;
  }
  .group.hidden { display: none; }

  .group-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 0 0 8px 0;
    margin: 0;
    width: 100%;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
  }

  .group-header .chevron {
    font-size: 10px;
    color: var(--fg-subtle);
    transition: transform 0.15s ease;
    display: inline-block;
    width: 10px;
  }

  .group-header[aria-expanded="true"] .chevron {
    transform: rotate(90deg);
  }

  .group-header h2 {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .group-header .group-id {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--fg-subtle);
  }

  .group.collapsed .project { display: none; }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 24px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
    transition: background-color 0.3s, opacity 0.15s;
  }

  .project:last-child { border-bottom: none; }
  .project.hidden { display: none; }
  .project.flash { background: var(--highlight); }

  .project .year {
    font-size: 12px;
    color: var(--fg-subtle);
    padding-top: 2px;
  }

  .project .body h3 {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .project .body h3 a,
  .project .body h3 span {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }

  .project .body h3 a:hover {
    border-bottom-color: var(--fg);
  }

  .project .body p {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .project .tags {
    margin-top: 6px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--fg-subtle);
  }

  .project .tags .tag {
    cursor: pointer;
    transition: color 0.15s;
  }

  .project .tags .tag:hover {
    color: var(--fg);
  }

  .project .links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    align-self: start;
    padding-top: 4px;
  }

  .project .links a {
    color: var(--fg-subtle);
    text-decoration: none;
    transition: color 0.15s;
  }

  .project .links a:hover {
    color: var(--fg);
  }

  @media (max-width: 600px) {
    .project {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .project .year {
      order: -1;
    }
    .project .links {
      padding-top: 8px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.group-header').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.group')?.classList.toggle('collapsed');
    });
  });
</script>
