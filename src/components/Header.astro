<header>
  <div class="identity">
    <h1>Sam Warr</h1>
    <p class="tagline">
      Student at BYU studying Cybersecurity. I spend my time working on  self-hosting, retrocomputing, fpgas, 3d printing/cnc, hardware hacking.
    </p>
    <div class="meta-row">
      <span>Provo, UT</span>
      <span>·</span>
      <a href="https://github.com/sammothxc">github</a>
      <a href="mailto:sam.warr.tx@gmail.com">email</a>
      <a href="/pgp" title="4AF6 34A9 7409 9C2A  73FE C041 D0CD 80AE  1F99 FF24">pgp</a>
    </div>
  </div>
  <div class="life-frame" id="lifeFrame" title="click to reseed">
    <canvas id="life" width="24" height="24"></canvas>
    <span class="life-label mono">life ↻</span>
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 56px;
  }

  .identity h1 {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .identity .tagline {
    color: var(--fg-muted);
    max-width: 42ch;
    margin-bottom: 16px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--fg-subtle);
  }

  .meta-row a {
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .meta-row a:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  .life-frame {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border: 1px solid var(--border);
    background: var(--life-bg);
    position: relative;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .life-frame:hover {
    border-color: var(--border-strong);
  }

  #life {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .life-label {
    position: absolute;
    bottom: -18px;
    right: 0;
    font-size: 10px;
    color: var(--fg-subtle);
    letter-spacing: 0.05em;
  }

  @media (max-width: 600px) {
    header {
      flex-direction: column-reverse;
    }
    .life-frame {
      align-self: flex-start;
    }
    .identity h1 {
      font-size: 28px;
    }
  }
</style>

<script>
  const canvas = document.getElementById('life') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const SIZE = 24;
    let grid: number[][] = [];

    function seed() {
      grid = Array.from({ length: SIZE }, () =>
        Array.from({ length: SIZE }, () => (Math.random() < 0.32 ? 1 : 0))
      );
    }

    function step() {
      const next = grid.map((r) => r.slice());
      for (let y = 0; y < SIZE; y++) {
        for (let x = 0; x < SIZE; x++) {
          let n = 0;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              if (dx === 0 && dy === 0) continue;
              const nx = (x + dx + SIZE) % SIZE;
              const ny = (y + dy + SIZE) % SIZE;
              n += grid[ny][nx];
            }
          }
          if (grid[y][x] === 1) next[y][x] = n === 2 || n === 3 ? 1 : 0;
          else next[y][x] = n === 3 ? 1 : 0;
        }
      }
      grid = next;
    }

    function draw() {
      const cs = getComputedStyle(document.documentElement);
      const cell = cs.getPropertyValue('--life-cell').trim();
      const bg = cs.getPropertyValue('--life-bg').trim();
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, SIZE, SIZE);
      ctx.fillStyle = cell;
      for (let y = 0; y < SIZE; y++) {
        for (let x = 0; x < SIZE; x++) {
          if (grid[y][x]) ctx.fillRect(x, y, 1, 1);
        }
      }
    }

    let lastHash = '';
    let stallCount = 0;
    function tick() {
      step();
      draw();
      const hash = grid.flat().join('');
      if (hash === lastHash) {
        stallCount++;
        if (stallCount > 6) {
          seed();
          stallCount = 0;
        }
      } else {
        stallCount = 0;
      }
      lastHash = hash;
    }

    document.getElementById('lifeFrame')!.addEventListener('click', () => {
      seed();
      draw();
    });

    seed();
    draw();
    setInterval(tick, 600);
  }
</script>
